// Esquema de datos — SIGO-Dental
// Fase 1 (Core Administrativo y Turnos) + cimientos del core clínico y financiero.
// Referencias a requerimientos del documento: RF-xx, RNF-xx, RN-xx.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// USUARIOS Y ROLES (RNF-05 RBAC)
// ---------------------------------------------------------------------------

enum Role {
  ADMIN_TI // Administrador TI / Sistema
  RECEPCION // Recepcionista / Cajero
  ODONTOLOGO // Odontólogo general / especialista
  ASISTENTE // Asistente dental
  AUDITOR // Auditor / Contador
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean  @default(true)
  mfaEnabled   Boolean  @default(false) // MFA activo (RNF-05)
  mfaSecret    String?  // secreto TOTP (base32) cuando MFA está configurado
  // Configuración de comisión / honorarios (RF-13)
  commissionType  CommissionType @default(PORCENTAJE)
  commissionValue Decimal        @default(0) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones donde el usuario actúa como profesional
  appointments   Appointment[]   @relation("DentistAppointments")
  treatmentPlans TreatmentPlan[] @relation("DentistPlans")
  auditLogs      AuditLog[]
  toothRecords   ToothRecord[]
  clinicalNotes  ClinicalNote[]
  consents       Consent[]
  invoices       Invoice[]       @relation("DentistInvoices")
  cashSessions   CashSession[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// PACIENTES (RF-01 Registro unificado, RF-02 Anamnesis y alertas)
// ---------------------------------------------------------------------------

enum Gender {
  MASCULINO
  FEMENINO
  OTRO
}

model Patient {
  id            String    @id @default(uuid())
  documentId    String    @unique // cédula / identificación
  firstName     String
  lastName      String
  birthDate     DateTime
  gender        Gender
  phone         String?
  email         String?
  address       String?
  // Contacto de emergencia
  emergencyName  String?
  emergencyPhone String?
  // Tutor legal (si es menor de edad)
  guardianName   String?
  guardianPhone  String?
  // Seguro / convenio dental
  insuranceProvider String?
  insuranceNumber   String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicalHistory MedicalHistory?
  appointments   Appointment[]
  treatmentPlans TreatmentPlan[]
  invoices       Invoice[]
  toothRecords       ToothRecord[]
  perioMeasurements  PerioMeasurement[]
  perioTeeth         PerioTooth[]
  clinicalNotes      ClinicalNote[]
  consents           Consent[]

  @@map("patients")
}

// RF-02: historial médico general. Las condiciones críticas disparan el badge
// de alerta de alta visibilidad en la cabecera del expediente.
model MedicalHistory {
  id        String  @id @default(uuid())
  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  systemicDiseases String? // enfermedades sistémicas
  surgicalHistory  String? // antecedentes quirúrgicos
  allergies        String? // alergias a fármacos (texto libre)
  coagulopathies   Boolean @default(false)
  isAnticoagulated Boolean @default(false)
  penicillinAllergy Boolean @default(false)
  // Lista de alertas críticas calculadas/declaradas para el badge (RF-02)
  criticalAlerts   String[] @default([])

  updatedAt DateTime @updatedAt

  @@map("medical_histories")
}

// ---------------------------------------------------------------------------
// AGENDA (RF-09 multirrecinto, RF-10 estados, RN-03 no solapar sillón)
// ---------------------------------------------------------------------------

// Sillón / consultorio físico
model Operatory {
  id        String        @id @default(uuid())
  name      String        @unique // ej. "Sillón 1"
  isActive  Boolean       @default(true)
  appointments Appointment[]

  @@map("operatories")
}

enum AppointmentStatus {
  PROGRAMADO
  CONFIRMADO
  EN_SALA_ESPERA
  EN_ATENCION
  ATENDIDO
  CANCELADO
  NO_ASISTIO
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  dentistId   String
  dentist     User              @relation("DentistAppointments", fields: [dentistId], references: [id])
  operatoryId String
  operatory   Operatory         @relation(fields: [operatoryId], references: [id])

  startsAt DateTime
  endsAt   DateTime
  status   AppointmentStatus @default(PROGRAMADO)
  reason   String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatoryId, startsAt])
  @@index([dentistId, startsAt])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// CATÁLOGO CLÍNICO Y TRATAMIENTOS (RF-07, RF-08)
// ---------------------------------------------------------------------------

model Procedure {
  id        String   @id @default(uuid())
  code      String   @unique // ej. "D2150"
  name      String
  basePrice Decimal  @db.Decimal(10, 2)
  labCost   Decimal  @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(true)

  treatmentItems TreatmentItem[]
  supplies       ProcedureSupply[] // receta estándar de consumo (RF-14)
  invoiceItems   InvoiceItem[]

  @@map("procedures")
}

enum TreatmentPlanStatus {
  BORRADOR
  PRESENTADO
  APROBADO_TOTAL
  APROBADO_PARCIAL
  RECHAZADO
}

model TreatmentPlan {
  id        String              @id @default(uuid())
  patientId String
  patient   Patient             @relation(fields: [patientId], references: [id])
  dentistId String
  dentist   User                @relation("DentistPlans", fields: [dentistId], references: [id])
  status    TreatmentPlanStatus @default(BORRADOR)
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  items TreatmentItem[]

  @@map("treatment_plans")
}

model TreatmentItem {
  id          String        @id @default(uuid())
  planId      String
  plan        TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  procedureId String
  procedure   Procedure     @relation(fields: [procedureId], references: [id])
  phase       Int           @default(1) // fase / sesión
  toothNumber String? // notación FDI / Universal
  fee         Decimal       @db.Decimal(10, 2)
  labCost     Decimal       @default(0) @db.Decimal(10, 2)
  discount    Decimal       @default(0) @db.Decimal(10, 2)
  isApproved  Boolean       @default(false) // RF-08 aprobación por ítem

  @@map("treatment_items")
}

// ---------------------------------------------------------------------------
// FACTURACIÓN Y PAGOS (RF-12 básico)
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  EMITIDA
  PAGADA
  PARCIAL
  ANULADA
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_CREDITO
  TARJETA_DEBITO
  TRANSFERENCIA
  SEGURO
}

model Invoice {
  id        String        @id @default(uuid())
  number    String        @unique
  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id])
  // Profesional tratante (para liquidación de honorarios, RF-13)
  dentistId String?
  dentist   User?         @relation("DentistInvoices", fields: [dentistId], references: [id])
  status    InvoiceStatus @default(EMITIDA)
  subtotal  Decimal       @db.Decimal(10, 2)
  tax       Decimal       @default(0) @db.Decimal(10, 2)
  total     Decimal       @db.Decimal(10, 2)
  issuedAt  DateTime      @default(now())

  items    InvoiceItem[]
  payments Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String     @id @default(uuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Procedimiento del catálogo (dispara descargo de insumos, RF-14)
  procedureId String?
  procedure   Procedure? @relation(fields: [procedureId], references: [id])
  description String
  quantity    Int        @default(1)
  unitPrice   Decimal    @db.Decimal(10, 2)
  lineTotal   Decimal    @db.Decimal(10, 2)

  @@map("invoice_items")
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  paidAt    DateTime      @default(now())

  @@map("payments")
}

// ---------------------------------------------------------------------------
// AUDITORÍA (RNF-06 log inmutable de acciones CRUD)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // CREATE | READ | UPDATE | DELETE | EXPORT
  entity     String // recurso afectado
  entityId   String?
  ipAddress  String?
  timestamp  DateTime @default(now()) // ISO-8601
  metadata   Json?

  @@index([entity, timestamp])
  @@map("audit_logs")
}

// ===========================================================================
// FASE 2 — CORE CLÍNICO
// ===========================================================================

// ---------------------------------------------------------------------------
// ODONTOGRAMA (RF-03)
// ---------------------------------------------------------------------------

enum Dentition {
  PERMANENTE // 32 dientes
  TEMPORAL // 20 dientes (decidua)
}

enum ToothSurface {
  MESIAL
  DISTAL
  OCLUSAL // oclusal / incisal
  VESTIBULAR
  LINGUAL // lingual / palatino
  GENERAL // condición de todo el diente (exodoncia, implante, prótesis)
}

enum ToothCondition {
  SANO
  CARIES // rojo
  RESTAURACION // azul
  ENDODONCIA
  IMPLANTE
  PROTESIS_FIJA
  PROTESIS_REMOVIBLE
  EXODONCIA
  SELLANTE
  CORONA
}

// Estado actual por superficie dental. Único por (paciente, diente, superficie).
model ToothRecord {
  id         String         @id @default(uuid())
  patientId  String
  patient    Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentition  Dentition      @default(PERMANENTE)
  toothNumber String        // notación FDI (ej. "11", "48")
  surface    ToothSurface
  condition  ToothCondition
  notes      String?
  recordedById String?
  recordedBy   User?        @relation(fields: [recordedById], references: [id])
  updatedAt  DateTime       @updatedAt

  @@unique([patientId, toothNumber, surface])
  @@map("tooth_records")
}

// ---------------------------------------------------------------------------
// PERIODONTOGRAMA (RF-04)
// ---------------------------------------------------------------------------

enum PerioSite {
  MV // mesio-vestibular
  V  // vestibular
  DV // disto-vestibular
  MP // mesio-palatino/lingual
  P  // palatino/lingual
  DP // disto-palatino/lingual
}

// Profundidad al sondaje y márgenes por sitio (6 por diente).
model PerioMeasurement {
  id            String    @id @default(uuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothNumber   String
  site          PerioSite
  probingDepth  Int       @default(0) // mm
  gingivalMargin Int      @default(0) // mm (negativo = recesión)
  bleeding      Boolean   @default(false) // sangrado al sondaje
  updatedAt     DateTime  @updatedAt

  @@unique([patientId, toothNumber, site])
  @@map("perio_measurements")
}

// Datos de periodonto por diente (movilidad, furca). Único por (paciente, diente).
model PerioTooth {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothNumber String
  mobility    Int      @default(0) // 0-3
  furcation   Int      @default(0) // 0-3
  updatedAt   DateTime @updatedAt

  @@unique([patientId, toothNumber])
  @@map("perio_teeth")
}

// ---------------------------------------------------------------------------
// NOTAS DE EVOLUCIÓN SOEP (RF-05) — bitácora inmutable y firmada
// ---------------------------------------------------------------------------

model ClinicalNote {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  subjective String // S
  objective  String // O
  evaluation String // E
  plan       String // P
  signedAt   DateTime @default(now()) // firma digital del profesional
  // Tras esta fecha la nota queda bloqueada contra edición (RF-05, default 24h)
  lockedAt   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([patientId, createdAt])
  @@map("clinical_notes")
}

// ---------------------------------------------------------------------------
// CONSENTIMIENTO INFORMADO DIGITAL (RF-06)
// ---------------------------------------------------------------------------

enum CommissionType {
  PORCENTAJE // % sobre honorarios
  MONTO_FIJO // monto fijo por procedimiento
  PORCENTAJE_NETO // % tras deducir costo de laboratorio/materiales
}

enum ConsentMethod {
  FIRMA_BIOMETRICA // firma en pantalla táctil
  OTP // validación por código enviado al paciente
}

model Consent {
  id              String        @id @default(uuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title           String
  body            String // texto legal del consentimiento por procedimiento
  method          ConsentMethod @default(FIRMA_BIOMETRICA)
  signatureDataUrl String?      @db.Text // imagen de la firma (data URL)
  patientSignerName String?
  signedAt        DateTime?
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([patientId, createdAt])
  @@map("consents")
}

// ===========================================================================
// FASE 3 — INVENTARIO, CAJA Y REPORTES
// ===========================================================================

// ---------------------------------------------------------------------------
// INVENTARIO Y DESCARGO AUTOMÁTICO (RF-14)
// ---------------------------------------------------------------------------

model Supply {
  id        String  @id @default(uuid())
  name      String  @unique // ej. "Anestesia lidocaína", "Guantes"
  unit      String  @default("unidad") // unidad, ml, par, caja
  stock     Int     @default(0)
  minStock  Int     @default(0) // umbral de reposición
  isActive  Boolean @default(true)

  recipes   ProcedureSupply[]
  movements StockMovement[]

  @@map("supplies")
}

// Receta estándar de consumo: insumos que descarga un procedimiento.
model ProcedureSupply {
  id          String    @id @default(uuid())
  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  supplyId    String
  supply      Supply    @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  quantity    Int       @default(1)

  @@unique([procedureId, supplyId])
  @@map("procedure_supplies")
}

enum StockMovementType {
  ENTRADA // compra / reposición
  SALIDA // consumo clínico (descargo)
  AJUSTE // corrección de inventario
}

model StockMovement {
  id        String            @id @default(uuid())
  supplyId  String
  supply    Supply            @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int // positivo entrada, negativo salida
  reason    String?
  createdAt DateTime          @default(now())

  @@index([supplyId, createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// CIERRE DE CAJA CIEGO (RN-02)
// ---------------------------------------------------------------------------

enum CashSessionStatus {
  ABIERTA
  CERRADA
}

model CashSession {
  id             String            @id @default(uuid())
  openedById     String
  openedBy       User              @relation(fields: [openedById], references: [id])
  openingAmount  Decimal           @db.Decimal(10, 2)
  status         CashSessionStatus @default(ABIERTA)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  // El cajero ingresa el conteo físico ANTES de ver el total teórico (RN-02)
  countedAmount  Decimal?          @db.Decimal(10, 2)
  expectedAmount Decimal?          @db.Decimal(10, 2)
  difference     Decimal?          @db.Decimal(10, 2)
  notes          String?

  @@map("cash_sessions")
}
