# Base de datos (coincide con docker-compose.yml)
DATABASE_URL="postgresql://sigo:sigo_dev_2026@localhost:5433/sigo_dental?schema=public"

# JWT
JWT_SECRET="cambia-esto-en-produccion-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# App
PORT=3000
# Minutos de inactividad antes de expirar sesión en cliente (RNF-05)
SESSION_IDLE_MINUTES=15
# Horas antes de bloquear una nota SOEP contra edición (RF-05)
SOEP_LOCK_HOURS=24
